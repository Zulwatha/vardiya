{
  "name": "vardiya",
  "version": "0.2.0",
  "description": "SQLite-backed job queue for Node.js. Durable background jobs, retries, priorities and cron scheduling with zero infrastructure. No Redis.",
  "license": "MIT",
  "author": "Zulwatha",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/bench.ts",
    "prepublishOnly": "npm run build"
  },
  "sideEffects": false,
  "dependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "back-end",
    "queue",
    "job-queue",
    "task-queue",
    "background-jobs",
    "sqlite",
    "better-sqlite3",
    "worker",
    "cron",
    "scheduler",
    "delayed-jobs",
    "retry",
    "bullmq-alternative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zulwatha/vardiya.git"
  },
  "bugs": {
    "url": "https://github.com/Zulwatha/vardiya/issues"
  },
  "homepage": "https://github.com/Zulwatha/vardiya#readme"
}
